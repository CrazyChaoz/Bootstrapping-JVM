#!/usr/bin/env python3
"""Extract Gradle's module graph from its build scripts (no Gradle needed).

usage: gradle-modules <gradle-src> > modules.json

For every subproject listed in settings.gradle.kts this records its directory,
its build plugins and its main-source-set dependencies (project dependencies
by name, external ones by version-catalog alias or literal coordinates).
"""
import json
import os
import re
import sys

root = sys.argv[1]


def kebab(camel):
    return re.sub(r"([A-Z])", lambda m: "-" + m.group(1).lower(), camel)


def strip_comments(text):
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    return "\n".join(re.sub(r"(^|\s)//.*$", "", l) for l in text.splitlines())


def settings_modules():
    text = strip_comments(open(os.path.join(root, "settings.gradle.kts")).read())
    mods = {}
    stack = []  # (kind, name, depth)
    depth = 0
    for line in text.splitlines():
        m = re.search(r'\b(platform|module|unassigned|packaging|testing)\s*(?:\(\s*"([^"]+)"\s*\))?\s*\{', line)
        if m:
            stack.append((m.group(1), m.group(2), depth))
        for sm in re.finditer(r'subproject\("([^"]+)"\)', line):
            name = sm.group(1)
            kind, group = (stack[-1][0], stack[-1][1]) if stack else ("unassigned", None)
            if kind == "unassigned":
                d = f"subprojects/{name}"
            elif kind in ("packaging", "testing"):
                d = f"{kind}/{name}"
            elif kind == "module" and len(stack) > 1 and stack[-2][0] == "platform":
                d = f"platforms/{group}/{name}"
            else:
                d = f"platforms/{group}/{name}"
            mods[name] = d
        depth += line.count("{") - line.count("}")
        while stack and depth <= stack[-1][2]:
            stack.pop()
    return mods


CONFS = ["api", "implementation", "compileOnly", "compileOnlyApi", "runtimeOnly",
         "annotationProcessor", "shadow", "manifestClasspath", "runtime",
         "coreRuntimeOnly", "pluginsRuntimeOnly", "agentsRuntimeOnly", "shadedImplementation",
         "externalApi", "legacyExternalApi"]


COORDS = {
    "org.gradle:java-api-extractor": "project:java-api-extractor",
    "org.jetbrains.kotlinx:kotlinx-metadata-jvm:0.5.0": "lib:kotlinxMetadataJvm",
    "antlr:antlr:2.7.7": "lib:antlr",
    "commons-io:commons-io:2.11.0": "lib:commonsIo",
}
FUTURE_KOTLIN = {
    "stdlib": "lib:kotlinStdlib",
    "reflect": "lib:kotlinReflect",
    "script-runtime": "lib:kotlinScriptRuntime",
    "scripting-common": "lib:kotlinScriptingCommon",
    "scripting-jvm": "lib:kotlinScriptingJvm",
    "scripting-jvm-host": "lib:kotlinScriptingJvmHost",
    "scripting-compiler-embeddable": "lib:kotlinScriptingCompilerEmbeddable",
    "scripting-compiler-impl-embeddable": "lib:kotlinScriptingCompilerImplEmbeddable",
    "sam-with-receiver-compiler-plugin": "lib:kotlinSamWithReceiverCompilerPlugin",
    "assignment-compiler-plugin-embeddable": "lib:kotlinAssignmentCompilerEmbeddable",
}


def parse_deps(text):
    """Return {conf: [dep, ...]} for the top-level `dependencies { }` block(s)."""
    deps = {}
    # only the top-level dependencies blocks
    for m in re.finditer(r"(?m)^dependencies\s*\{", text):
        i = m.end()
        level = 1
        while level and i < len(text):
            level += {"{": 1, "}": -1}.get(text[i], 0)
            i += 1
        body = text[m.end():i - 1]
        for dm in re.finditer(r"(?m)^\s*(\w+)\((.*?)\)\s*(\{|$)", body):
            conf, arg = dm.group(1), dm.group(2).strip()
            if conf not in CONFS:
                continue
            dep = None
            if (pm := re.fullmatch(r"projects\.([\w.]+)", arg)):
                dep = "project:" + kebab(pm.group(1).split(".")[-1])
            elif (pm := re.fullmatch(r'project\(":([\w-]+)"\)', arg)):
                dep = "project:" + pm.group(1)
            elif (pm := re.fullmatch(r"(libs|testLibs|buildLibs|providedLibs)\.([\w.]+)", arg)):
                dep = "lib:" + pm.group(2)
            elif arg == '"org.gradle:kotlin-dsl-shared-runtime"':
                dep = "project:kotlin-dsl-shared-runtime"
            elif (pm := re.fullmatch(r'"([^"]+)"', arg)):
                dep = COORDS.get(pm.group(1), "coord:" + pm.group(1))
            elif (pm := re.fullmatch(r'libs\.futureKotlin\("([\w-]+)"\)', arg)):
                dep = FUTURE_KOTLIN.get(pm.group(1), "other:" + arg)
            elif (pm := re.fullmatch(r"platform\(projects\.([\w.]+)\)", arg)):
                dep = "project:" + kebab(pm.group(1).split(".")[-1])
            elif (pm := re.fullmatch(r"platform\((.*)\)", arg)):
                continue
            elif (pm := re.fullmatch(r"testFixtures\((.*)\)", arg)):
                dep = "testFixtures:" + arg
            else:
                dep = "other:" + arg
            deps.setdefault(conf, []).append(dep)
    return deps


def plugins(text):
    m = re.search(r"(?ms)^plugins\s*\{(.*?)^\}", text)
    if not m:
        return []
    out = []
    for pm in re.finditer(r'id\("([^"]+)"\)|`([\w-]+)`|alias\(([\w.]+)\)|embeddedKotlin\("([^"]+)"\)', m.group(1)):
        out.append(pm.group(1) or pm.group(2) or pm.group(3) or "kotlin." + pm.group(4))
    return out


def balanced(text, start):
    """Text of the {...} block whose '{' is at text[start]."""
    level, i = 0, start
    while i < len(text):
        level += {"{": 1, "}": -1}.get(text[i], 0)
        i += 1
        if level == 0:
            break
    return text[start + 1:i - 1]


def runtimes(text):
    out = {}
    m = re.search(r"computedRuntimes\s*\{", text)
    if m:
        body = balanced(text, m.end() - 1)
        for k in ("client", "daemon", "worker"):
            if re.search(rf"\b{k}\s*=\s*true", body):
                out[k] = True
    return out


def main_compilation(text):
    """Settings of the main compilation from the jvmCompile {} block."""
    out = {}
    m = re.search(r"(?m)^jvmCompile\s*\{", text)
    if not m:
        return out
    body = balanced(text, m.end() - 1)
    for nm in re.finditer(r'named\("main"\)\s*\{', body):
        b = balanced(body, nm.end() - 1)
        if re.search(r"usesJdkInternals\s*=\s*true", b):
            out["usesJdkInternals"] = True
        if re.search(r"usesFutureStdlib\s*=\s*true", b):
            out["usesFutureStdlib"] = True
        t = re.search(r"targetJvmVersion\s*=\s*(\d+)", b)
        if t:
            out["targetJvmVersion"] = int(t.group(1))
    return out


def src_info(d):
    info = {}
    main = os.path.join(root, d, "src/main")
    if not os.path.isdir(main):
        return info
    for lang in sorted(os.listdir(main)):
        p = os.path.join(main, lang)
        n = {"java": 0, "kt": 0, "groovy": 0}
        for dp, _, fs in os.walk(p):
            for f in fs:
                ext = f.rsplit(".", 1)[-1]
                if ext in n:
                    n[ext] += 1
        info[lang] = {k: v for k, v in n.items() if v} or True
    return info


# dependencies added by convention plugins (build-logic/uber-plugins)
IMPLICIT = {
    "gradlebuild.instrumented-java-project": {
        "compileOnly": ["project:base-asm", "project:internal-instrumentation-api",
                        "project:stdlib-java-extensions", "lib:asm", "lib:asmTree"],
        "annotationProcessor": ["project:internal-instrumentation-processor"],
    },
}
IMPLIES = {
    "gradlebuild.distribution.api-java": ["gradlebuild.instrumented-java-project"],
    "gradlebuild.distribution.api-kotlin": [],
}


def expand(ps):
    seen = []
    todo = list(ps)
    while todo:
        p = todo.pop()
        if p not in seen:
            seen.append(p)
            todo += IMPLIES.get(p, [])
    return seen


out = {}
for name, d in settings_modules().items():
    path = os.path.join(root, d, "build.gradle.kts")
    if not os.path.exists(path):
        print(f"warning: no build script for {name} ({d})", file=sys.stderr)
        continue
    text = strip_comments(open(path).read())
    ps = plugins(text)
    deps = parse_deps(text)
    for p in expand(ps):
        for conf, ds in IMPLICIT.get(p, {}).items():
            for x in ds:
                if x not in deps.setdefault(conf, []) and x != "project:" + name:
                    deps[conf].append(x)
    out[name] = {
        "dir": d,
        "plugins": ps,
        "deps": deps,
        "src": src_info(d),
        "runtimes": runtimes(text),
        "main": main_compilation(text),
    }
    opt = re.findall(r'optionalProjects\.add\("([^"]+)"\)', text)
    if opt:
        out[name]["optional"] = opt
# build-logic projects that the distribution embeds
if os.path.isdir(os.path.join(root, "build-logic/java-api-extractor")):
    out["java-api-extractor"] = {
        "dir": "build-logic/java-api-extractor",
        "plugins": [],
        "deps": {"api": ["lib:asm", "lib:guava"]},
        "src": src_info("build-logic/java-api-extractor"),
        "runtimes": {},
        "main": {"targetJvmVersion": 8},
    }
if not os.path.isdir(os.path.join(root, "build-logic/kotlin-dsl-shared-runtime")):
    json.dump(out, sys.stdout, indent=1, sort_keys=True)
    print()
    sys.exit(0)
out["kotlin-dsl-shared-runtime"] = {
    "dir": "build-logic/kotlin-dsl-shared-runtime",
    "plugins": [],
    # (its build script: compileOnly only, so its registry entry has no dependencies; the
    # graphs of 8.14.3, 9.8.0, 9.8.1 and 9.9.0-RC1 still say api, to keep their builds)
    "deps": {"compileOnly": ["lib:kotlinStdlib", "lib:asmTree", "lib:jsr305", "lib:jspecify"]},
    "src": src_info("build-logic/kotlin-dsl-shared-runtime"),
    "runtimes": {},
    "main": {"targetJvmVersion": 8},
}
json.dump(out, sys.stdout, indent=1, sort_keys=True)
print()
