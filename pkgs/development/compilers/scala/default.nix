# The Scala chain: from the boot compiler of 2004 (Java with algebraic data types), built by PiCo, through
# Scala 1.x, the first Scala 2 compiler (nsc, 2005-12) and the 2.x releases to 2.13.18, and
# from 2.12.8 through the Scala 3 (dotty) releases to 3.10.0; each stage compiled by the
# previous one, no Scala binary anywhere.
#
# The stages are those of chain/scala2.txt (chain.nix, generated by
# scripts/scala-chain) and chain/dotty.txt (dotty.nix); how each is built, its
# generation, is in generations.nix; the builders are the scripts of builders/.
{
  lib,
  stdenv,
  fetchzip,
  fetchurl,
  fetchFromGitHub,
  runCommand,
  writeText,
  python3,
  jdks,
  pico,
}:

let
  chain = import ./chain.nix;
  generations = import ./generations.nix { patches = ./patches; };

  # runs the compilers (the old class file readers and run-time libraries want a Java 8
  # class library)
  jdk8 = jdks.openjdk8;
  # compiles the Java parts (javac --release 8)
  jdk21 = jdks.openjdk21;

  deps = import ./deps.nix {
    inherit
      lib
      stdenv
      fetchFromGitHub
      runCommand
      jdk8
      jdk21
      ;
  };

  sourcesOf =
    root: names:
    lib.fileset.toSource {
      inherit root;
      fileset = lib.fileset.unions (map (n: root + "/${n}") names);
    };
  tools = sourcesOf ./tools [
    "classfile.py"
    "jdk-api-view.py"
    "scala-unnest.py"
    "scala-pickle-rename.py"
  ];
  # each builder with the files it uses, and its smoke test
  builders =
    lib.mapAttrs
      (
        _: files:
        sourcesOf ./. (
          [
            "builders/common.sh"
            "tests/Hello1.scala"
            "tests/Hello2.scala"
          ]
          ++ files
        )
      )
      {
        "boot.sh" = [ "builders/boot.sh" ];
        "scala1.sh" = [
          "builders/scala1.sh"
          "builders/scala1-patches.sh"
          "tests/hello1.sh"
        ];
        "nsc0.sh" = [
          "builders/nsc0.sh"
          "builders/nsc-patches.sh"
          "tests/hello2.sh"
        ];
        "scala2.sh" = [
          "builders/scala2.sh"
          "builders/nsc-patches.sh"
          "tests/hello2.sh"
        ];
      };
  tests = {
    "scala1.sh" = "hello1.sh";
    "nsc0.sh" = "hello2.sh";
    "scala2.sh" = "hello2.sh";
  };

  # A scala/scala tree, without the binaries it ships (lib/*.jar reference compilers and the
  # like).  scripts/scala-chain computes the hashes the same way.
  fetchScala =
    rev:
    fetchzip {
      name = "scala-src-${builtins.substring 0 10 rev}";
      url = "https://github.com/scala/scala/archive/${rev}.tar.gz";
      hash = chain.sources.${rev};
      postFetch = ''
        find $out -type f \( -name '*.jar' -o -name '*.class' -o -name '*.so' -o -name '*.dll' \
          -o -name '*.dylib' -o -name '*.exe' -o -name '*.zip' -o -name '*.a' -o -name '*.jnilib' \) -delete
      '';
    };
  sources = lib.mapAttrs (rev: _: fetchScala rev) chain.sources;

  # The Java class library as an old compiler should see it (like ct.sym): nothing newer than
  # `version`, see tools/jdk-api-view.py
  apiView =
    version:
    runCommand "jdk-api-${version}.jar" { nativeBuildInputs = [ python3 ]; } ''
      python3 -I ${tools}/jdk-api-view.py ${jdk8}/lib/openjdk/src.zip ${jdk8}/lib/openjdk/jre/lib/rt.jar ${version} $out
    '';
  apiViews = lib.genAttrs [ "1.4" "1.5" "1.6" ] apiView;

  # Scala's generified jline (lib/jline.jar from 2009-06), as it came as source in 2009-10
  jline5 = runCommand "jline-scala-2009" { } ''
    mkdir -p $out
    ${jdk8}/bin/javac -nowarn -encoding utf8 -d $out $(find ${sources.${chain.jline5}}/src/jline/src/main/java -name '*.java')
    cp -r ${sources.${chain.jline5}}/src/jline/src/main/resources/. $out/
  '';

  # a bridge: the tree of `rev` with some files of a later commit, or changed by a script
  stageSrc =
    s:
    if s ? overlay then
      runCommand "scala-src-${s.name}" { nativeBuildInputs = [ python3 ]; } ''
        cp -r --no-preserve=mode ${sources.${s.rev}} $out
        ${
          if s.overlay ? script then
            "bash ${./patches/bridges + "/${s.overlay.script}"} $out ${sources.${s.overlay.rev}}"
          else
            lib.concatMapStringsSep "\n" (f: "cp ${sources.${s.overlay.rev}}/${f} $out/${f}") s.overlay.files
        }
      ''
    else
      sources.${s.rev};

  # the builders' inputs, but for the scripts of scala/ and the stages
  commonInputs = {
    JDK8 = "${jdk8}";
    JDK21 = "${jdk21}";
    PICO = "${pico.pico}";
    TOOLS = "${tools}";
    FJBG_SRC = "${sources.${chain.fjbg}}/src/fjbg";
    MSIL_SRC = "${sources.${chain.msil}}/src/msil";
    RT14 = "${apiViews."1.4"}";
    RT15 = "${apiViews."1.5"}";
    RT16 = "${apiViews."1.6"}";
  };
  scala2Inputs = {
    JLINE_CLS = "${deps.jline}";
    JLINE5_CLS = "${jline5}";
    JANSI_CLS = "${deps.jansi}";
    ASM_SRCS = "${deps.scalaAsmSrcs}";
    DIFFUTILS_SRCS = "${deps.diffutilsSrcs}";
  };

  mkStage =
    s:
    let
      generation = generations.${s.generation};
      inherit (generation) builder;
    in
    stdenv.mkDerivation {
      pname = "scala-bootstrap-${s.name}";
      inherit (s) version;
      src = stageSrc s;
      dontUnpack = true;
      dontConfigure = true;
      dontFixup = true;
      nativeBuildInputs = [ python3 ];
      env =
        commonInputs
        // lib.optionalAttrs (builder == "scala2.sh") (
          scala2Inputs // { FJBG_CLS = "${stages.n0}/classes"; }
        )
        // lib.optionalAttrs (s.mode == "cf") { COMPILER_FIRST = "1"; }
        // lib.optionalAttrs (s.mode == "fresh") {
          NO_FALLBACK = "1";
          ARRAY_FROM_SOURCE = "1";
        }
        // generation.env or { };
      buildPhase = ''
        runHook preBuild
        bash ${builders.${builder}}/builders/${builder} $src $out ${
          lib.optionalString (s ? prev) "${stages.${s.prev}}"
        }
        runHook postBuild
      '';
      # what later stages and the smoke test use: the compiler and library (out2, quick/lib;
      # sc2, lib2 for the first stage), their Java dependencies (classes) and the sources (src)
      installPhase = ''
        runHook preInstall
        cd $out
        find . -mindepth 1 -maxdepth 1 ! -name out2 ! -name classes ! -name src ! -name sc2 ! -name lib2 ! -name quick -exec rm -rf {} +
        [ ! -d quick ] || find quick -mindepth 1 -maxdepth 1 ! -name lib -exec rm -rf {} +
        cd - > /dev/null
        runHook postInstall
      '';
      # the stage's compiler compiles and runs a small program
      doInstallCheck = tests ? ${builder};
      installCheckPhase = ''
        runHook preInstallCheck
        bash ${builders.${builder}}/tests/${tests.${builder} or ""} $out 2>&1 | grep -v '; signature = ' | tee hello.txt
        grep -q '^Hello from' hello.txt
        runHook postInstallCheck
      '';
      passthru = { inherit (s) rev generation; };
      meta = {
        description = "Stage ${s.name} of the Scala bootstrap chain (scala/scala ${builtins.substring 0 10 s.rev})";
        homepage = "https://github.com/scala/scala";
        license = lib.licenses.bsd3;
        platforms = lib.platforms.linux;
      };
    };

  stages = lib.listToAttrs (map (s: lib.nameValuePair s.name (mkStage s)) chain.stages);

  dotty = import ./dotty.nix {
    inherit
      lib
      stdenv
      fetchzip
      python3
      runCommand
      jdk8
      jdk21
      ;
    scala2Stages = stages;
    inherit (deps) scalaAsmSrcs;
  };

  # the published 3.10.0 jars, bit for bit (repro/README.md)
  repro = import ./repro {
    inherit
      lib
      stdenv
      runCommand
      writeText
      fetchurl
      python3
      ;
    jdk17 = jdks.openjdk17;
    d74 = dotty.stages.d74;
    s230 = stages.s230;
    scalajsSrc = "${dotty.inputs.SCALAJS_SRCS}/1.22.0";
  };
in
{
  inherit
    stages
    sources
    apiViews
    jline5
    dotty
    repro
    ;
  inherit (deps) jline jansi;
  "1.4.0.4" = stages.s10;
  "2.0.0" = stages.s14;
  "2.7.7" = stages.s52;
  "2.11.0" = stages.s180;
  "2.12.0" = stages.s194;
  "2.13.0" = stages.s206;
  "2.13.18" = stages.s230;
  "3.10.0" = dotty.latest;
  latest = dotty.latest;
  # the same inputs for the builders run by hand (scripts/env.sh): `nix build .#scala.builderEnv`
  builderEnv = writeText "scala-builder-env.sh" (
    lib.concatStrings (
      lib.mapAttrsToList (n: v: "export ${n}=${v}\n") (
        removeAttrs (commonInputs // scala2Inputs // dotty.inputs) [ "TOOLS" ]
      )
    )
  );
  # every stage, the dead ends included: `nix build .#scala.all`
  all = runCommand "scala-bootstrap-all" { } (
    ''
      mkdir $out
    ''
    + lib.concatStrings (lib.mapAttrsToList (n: s: "ln -s ${s} $out/${n}\n") (stages // dotty.stages))
  );
}
