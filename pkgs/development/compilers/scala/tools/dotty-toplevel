#!/usr/bin/env python3
"""dotty-toplevel SRCDIR : the class-file stems (PACKAGE/NAME) of the top-level definitions of the
Scala sources under SRCDIR: classes, traits, objects, enums, and FILE$package (Scala 3's wrapper of
top-level defs, vals and types)."""
import os
import re
import sys

root = sys.argv[1]
for d, _, fs in os.walk(root):
    for f in sorted(fs):
        if not f.endswith(".scala"):
            continue
        src = open(os.path.join(d, f), encoding="utf-8").read()
        pkg = "/".join(m for m in re.findall(r"^package\s+([\w.]+)", src, re.M) for m in m.split("."))
        names = set(re.findall(r"^(?:(?:final|sealed|abstract|private\[\w+\]|implicit|case|transparent|inline|open)\s+)*"
                               r"(?:class|trait|object|enum)\s+(\w+)", src, re.M))
        names.add(f[:-6] + "$package")
        for n in sorted(names):
            print(f"{pkg}/{n}" if pkg else n)
