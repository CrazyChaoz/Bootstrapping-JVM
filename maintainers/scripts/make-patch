#!/usr/bin/env bash
# usage: make-patch SRC WORKDIR OUT.patch  -- diff of all changed files
set -u
src=$1 work=$2 out=$(realpath -m "$3")
find "$work" -name '*.rej' -delete
: > "$out"
cd "$work" || exit 1
diff -rq "$src" . 2>/dev/null | while read -r l; do
  case "$l" in
    "Files "*) f=$(echo "$l" | sed -E 's|^Files [^ ]+ and \./(.*) differ$|\1|');;
    "Only in .:"*|"Only in ./"*) d=$(echo "$l" | sed -E 's|^Only in \.?/?([^:]*): (.*)$|\1/\2|; s|^/||'); f=$d;;
    "Only in $src"*) f=$(echo "$l" | sed -E "s|^Only in $src/?([^:]*): (.*)\$|\\1/\\2|; s|^/||");;
    *) continue;;
  esac
  f=${f#./}
  a="$src/$f"; b="./$f"; [ -e "$a" ] || a=/dev/null; [ -e "$b" ] || b=/dev/null
  diff -uN --label "a/$f" --label "b/$f" "$a" "$b" >> "$out"
done
echo "$(grep -c '^+++' "$out") files in $out"
