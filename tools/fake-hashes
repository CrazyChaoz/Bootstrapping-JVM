#!/usr/bin/env python3
"""Replace every "@H@" in the given files by a distinct fake SRI hash (for tools/fix-hashes)."""
import base64, hashlib, sys, time
n = 0
for f in sys.argv[1:]:
    s = open(f).read()
    while "@H@" in s:
        n += 1
        h = base64.b64encode(hashlib.sha256(f"{f}{n}{time.time()}".encode()).digest()).decode()
        s = s.replace("@H@", "sha256-" + h, 1)
    open(f, "w").write(s)
print(n, "placeholders")
