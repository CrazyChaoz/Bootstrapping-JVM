#!/usr/bin/env python3
# usage: kotlin-modules KOTLIN_SRC [EXTRA_GRADLE_PROJECT...]
# Prints the main source directories of the modules packed into
# kotlin-compiler.jar (root build.gradle.kts `compilerModules`), as a Nix list.
import re, sys, os
src = sys.argv[1]
extra = sys.argv[2:]

def read(p):
    p = os.path.join(src, p)
    return open(p).read() if os.path.exists(p) else ''

settings = read('settings.gradle') + read('settings.gradle.kts')
# project(':x:y').projectDir = "$rootDir/a/b" / File(rootDir, "a/b") / file("a/b")
dirs = {}
for m in re.finditer(r'''project\(\s*["']([^"']+)["']\s*\)\.projectDir\s*=\s*(?:new\s+)?(?:File\(\s*(?:rootDir|\$rootDir)\s*,\s*["']([^"']+)["']\s*\)|["']\$rootDir/([^"']+)["']|file\(\s*["']([^"']+)["']\s*\))''', settings):
    dirs[m.group(1)] = next(g for g in m.groups()[1:] if g)

root = read('build.gradle.kts')
m = re.search(r'extra\["compilerModules"\]\s*=\s*arrayOf\((.*?)\)', root, re.S)
mods = re.findall(r'"([^"]+)"', m.group(1)) + extra

def projdir(p):
    if p in dirs: return dirs[p]
    return p.strip(':').replace(':', '/')

out = []
for p in mods:
    d = projdir(p)
    b = read(os.path.join(d, 'build.gradle.kts')) or read(os.path.join(d, 'build.gradle'))
    srcs = []
    mm = re.search(r'"main"\s*\{(.*?)\n\s*\}', b, re.S) or re.search(r'"main"\s*\{([^}]*)\}', b)
    main = mm.group(1) if mm else ''
    if 'projectDefault' in main or not mm:
        srcs.append('src')
    for m2 in re.finditer(r'java\.srcDirs?\(([^)]*)\)|srcDirs\(([^)]*)\)', main):
        for s in re.findall(r'"([^"]+)"', m2.group(1) or m2.group(2)):
            if s not in srcs: srcs.append(s)
    if 'none()' in main: srcs = []
    for s in srcs:
        path = os.path.normpath(os.path.join(d, s))
        if os.path.isdir(os.path.join(src, path)):
            out.append(path)
        else:
            print(f'# missing: {p} {path}', file=sys.stderr)
print('[')
for o in dict.fromkeys(out): print(f'  "{o}"')
print(']')
