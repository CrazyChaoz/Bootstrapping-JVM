#!/usr/bin/env python3
"""dotty-deps TREE : the versions of the external inputs a dotty/scala3 tree's sbt build names,
as "KEY VERSION" lines: scalajs (scalajs-ir), zinc (compiler-interface), jline (jline 3+),
asm (scala-asm); and the compiler flags the build adds for the library (libopts: both
library builds, libopts-boot: the bootstrapped one only) as "KEY FLAG..." lines.  Reads project/*.scala and project/plugins.sbt; a version given by a name
(scalaJSVersion, zincVersion, ...) is looked up among their `val NAME = "..."` definitions."""
import glob
import os
import re
import sys

tree = sys.argv[1]
text = ""
for f in [os.path.join(tree, "project", "plugins.sbt")] + sorted(glob.glob(os.path.join(tree, "project", "*.scala"))):
    if os.path.exists(f):
        text += open(f, encoding="utf-8").read() + "\n"
vals = dict(re.findall(r'\bval\s+(\w+)\s*=\s*"([^"]+)"', text))


def dep(pattern):
    """the version of the first dependency matching pattern (`"org" % "name" % VERSION`)"""
    m = re.search(pattern + r'\s*%\s*("([^"$][^"]*)"|(\w+))', text)
    if not m:
        return None
    return m.group(2) or vals.get(m.group(3))


found = {
    "scalajs": dep(r'"sbt-scalajs"') or vals.get("scalaJSVersion"),
    "zinc": dep(r'"compiler-interface"') or vals.get("zincVersion"),
    "jline": dep(r'"jline-reader"') or vals.get("jlineVersion"),
    "asm": dep(r'"scala-asm"') or vals.get("asmVersion"),
}
for k, v in found.items():
    if v:
        print(k, v)


def block(start):
    """the text of the definition starting at `start` up to the next top-level lazy val/def"""
    i = text.find(start)
    if i < 0:
        return ""
    m = re.compile(r"\n  (lazy val|def|val) ").search(text, i + len(start))
    return text[i:m.start() if m else len(text)]


def flags(b):
    return [f for f in re.findall(r'"(-Y[\w-]+|-language:[\w,]+|-source(?::[\w.-]+)?)"', b) if f != "-Ythrough-tasty"]


# (the library projects were renamed in 2025-04: scala-library-nonbootstrapped / scala-library-bootstrapped)
print("libopts", *flags(block("lazy val dottyLibrarySettings") or block("lazy val `scala-library-nonbootstrapped`")))
print("libopts-boot", *flags(block("lazy val `dotty-library-bootstrapped`") or block("lazy val `scala-library-bootstrapped`")))
