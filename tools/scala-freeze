#!/usr/bin/env bash
# scala-freeze STAGE : freeze the current stage builders as a new generation for the
# stages up to STAGE (since the previous generation), once Nix has built them.
#
# Copies scala/stages (without gen/) and the tools the stages use to
# scala/stages/gen/N and puts "gen N" after STAGE in the chain record (and in the
# prototype's /tmp/sc/work/chain.txt, when present).  The derivations of those
# stages stay the same: their scripts are byte-identical, only their place moves.
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
stage=$1
cd "$ROOT"
n=1; while [ -d scala/stages/gen/$n ]; do n=$((n+1)); done
G=scala/stages/gen/$n
mkdir -p $G/tools
git ls-files scala/stages | grep -v '^scala/stages/gen/' | while read -r f; do
  r=${f#scala/stages/}; mkdir -p "$G/$(dirname "$r")"; cp -p "$f" "$G/$r"
done
for t in pizza2java.py pico-classfiles.py jdk-api-view.py scala-unnest.py; do cp -p tools/$t $G/tools/; done
git add $G   # the flake only sees tracked files
for c in scala/proto/chain.txt /tmp/sc/work/chain.txt; do
  [ -f $c ] || continue
  python3 - "$c" "$stage" "$n" <<'PY'
import os, sys, datetime
f, stage, n = sys.argv[1:]
L = open(f).read().split("\n")
i = [k for k, l in enumerate(L) if l.split()[:1] == [stage]][0]
L.insert(i + 1, "gen %s   # verified in Nix with scala/stages/gen/%s (%s)" % (n, n, datetime.date.today()))
open(f + ".new", "w").write("\n".join(L)); os.rename(f + ".new", f)
PY
done
python3 tools/scala-chain
echo "generation $n: stages up to $stage"
