#!/usr/bin/env python3
"""Generate nix/scala/chain.nix from the chain record scala/chain/scala2.txt.

usage: tools/scala-chain [GITDIR]    (GITDIR: a clone of scala/scala, default /tmp/sc/full)

scala2.txt has "generation NAME" lines and, under each, stage lines
"NAME COMMIT PREV MODE  # comment" (see its header).  For each stage chain.nix gets its
commit, generation, previous stage, mode and version (the release tag at the commit, else
0-unstable-DATE), and for each source tree the hash of fetchScala in nix/scala/default.nix:
GitHub's archive of the commit with the binaries removed, computed here from `git archive`
the same way (and reused from the existing chain.nix).
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CHAIN = os.path.join(ROOT, "scala/chain/scala2.txt")
OUT = os.path.join(ROOT, "nix/scala/chain.nix")
GIT = sys.argv[1] if len(sys.argv) > 1 else "/tmp/sc/full"

# inputs taken from later trees (nix/scala/default.nix)
FJBG = "0f10ffedc8"  # src/fjbg (2009), the JVM backend's class file library
MSIL = "4304b15730"  # src/msil (2009), the .NET class reader
JLINE5 = "c107643d20"  # src/jline (2009-10), the generified jline of lib/jline.jar from 2009-06
# keep in sync with fetchScala in nix/scala/default.nix
BINARIES = (".jar", ".class", ".so", ".dll", ".dylib", ".exe", ".zip", ".a", ".jnilib")


def nixfmt(path):
    """format path as nixpkgs does (nixfmt, or else nixpkgs' nixfmt-rfc-style)"""
    cmd = ["nixfmt"] if shutil.which("nixfmt") else ["nix", "run", "nixpkgs#nixfmt-rfc-style", "--"]
    subprocess.run(cmd + [path], check=True)


def git(*args):
    return subprocess.run(["git", "-C", GIT, *args], check=True, capture_output=True, text=True).stdout.strip()


def rev_parse(c):
    return git("rev-parse", c + "^{commit}")


def version(rev):
    tags = [t[1:] for t in git("tag", "--points-at", rev).split() if re.fullmatch(r"v\d+(\.\d+)+(-[A-Z0-9.]+)?", t)]
    return tags[0] if tags else "0-unstable-" + git("log", "-1", "--format=%cd", "--date=short", rev)


def tree_hash(rev):
    tmp = tempfile.mkdtemp()
    try:
        d = os.path.join(tmp, "src")
        os.mkdir(d)
        tar = subprocess.run(["git", "-C", GIT, "archive", "--format=tar", rev], check=True, capture_output=True).stdout
        subprocess.run(["tar", "-x", "-C", d], input=tar, check=True)
        for dp, _, fs in os.walk(d):
            for f in fs:
                p = os.path.join(dp, f)
                if f.endswith(BINARIES) and not os.path.islink(p):  # (find -type f)
                    os.remove(p)
        return subprocess.run(["nix", "hash", "path", "--type", "sha256", "--sri", d],
                              check=True, capture_output=True, text=True).stdout.strip()
    finally:
        shutil.rmtree(tmp)


def main():
    known = {}
    if os.path.exists(OUT):
        known = dict(re.findall(r'"([0-9a-f]{40})" = "(sha256-[^"]+)";', open(OUT).read()))

    stages, names, generation = [], set(), None
    for line in open(CHAIN):
        line = line.split("#")[0].strip()
        if not line:
            continue
        if line.startswith("generation "):
            generation = line.split()[1]
            continue
        name, commit, prev, mode = line.split()
        if prev != "-" and prev not in names:
            sys.exit(f"{name}: unknown previous stage {prev}")
        rev = rev_parse(commit)
        s = dict(name=name, rev=rev, version=version(rev), generation=generation, mode=mode)
        if prev != "-":
            s["prev"] = prev
        m = re.fullmatch(r"(bridge|bridge-script):([0-9a-f]+):(.*)", mode)
        if m:
            s["mode"] = "normal"
            frm = rev_parse(m.group(2))
            s["overlay"] = dict(rev=frm, script=m.group(3)) if m.group(1) == "bridge-script" \
                else dict(rev=frm, files=m.group(3).split(","))
        elif mode not in ("normal", "cf", "fresh"):
            sys.exit(f"{name}: unknown mode {mode}")
        names.add(name)
        stages.append(s)

    revs = [rev_parse(FJBG), rev_parse(MSIL), rev_parse(JLINE5)]
    for s in stages:
        revs.append(s["rev"])
        if "overlay" in s:
            revs.append(s["overlay"]["rev"])
    hashes = {}
    for r in revs:
        if r not in hashes:
            hashes[r] = known.get(r) or tree_hash(r)
            if r not in known:
                print(f"hashed {r[:10]}: {hashes[r]}", file=sys.stderr)

    o = ["# Generated by tools/scala-chain from scala/chain/scala2.txt -- do not edit.",
         "{",
         f'  fjbg = "{revs[0]}";',
         f'  msil = "{revs[1]}";',
         f'  jline5 = "{revs[2]}";',
         "  # scala/scala trees: rev -> hash of fetchScala",
         "  sources = {"]
    o += [f'    "{r}" = "{h}";' for r, h in hashes.items()]
    o += ["  };", "  stages = ["]
    for s in stages:
        a = [f'name = "{s["name"]}";', f'rev = "{s["rev"]}";', f'version = "{s["version"]}";',
             f'generation = "{s["generation"]}";', f'mode = "{s["mode"]}";']
        if "prev" in s:
            a.append(f'prev = "{s["prev"]}";')
        if "overlay" in s:
            ov = s["overlay"]
            if "script" in ov:
                a.append(f'overlay = {{ rev = "{ov["rev"]}"; script = "{ov["script"]}"; }};')
            else:
                fs = " ".join(f'"{f}"' for f in ov["files"])
                a.append(f'overlay = {{ rev = "{ov["rev"]}"; files = [ {fs} ]; }};')
        o.append("    { " + " ".join(a) + " }")
    o += ["  ];", "}", ""]
    open(OUT, "w").write("\n".join(o))
    nixfmt(OUT)
    print(f"{OUT}: {len(stages)} stages, {len(hashes)} source trees", file=sys.stderr)


if __name__ == "__main__":
    main()
