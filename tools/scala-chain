#!/usr/bin/env python3
"""Generate nix/scala/chain.nix from the chain record scala/proto/chain.txt.

usage: tools/scala-chain [GITDIR]    (GITDIR: a clone of scala/scala, default /tmp/sc/full)

chain.txt lines are "NAME COMMIT PREV MODE [VAR=VALUE...]" (VARs: builder environment); PREV "1" is stage 1 (stage1.sh),
MODE is normal, cf (compiler-first), fresh (no fallback library, Array from
source), unnest (locker from single-package-clause sources), nsc0 (the first Scala 2 compiler) or
bridge:FROMCOMMIT:FILE,... (COMMIT with FILEs taken from FROMCOMMIT),
bridge-script:FROMCOMMIT:SCRIPT (COMMIT's tree changed by scala/bridges/SCRIPT TREE FROMTREE).
"gen N" lines: the stages above them (since the previous such line) build with
the frozen scripts of scala/stages/gen/N (nix/scala/default.nix).  The
builder follows from the position in the chain: stage.sh (Scala 1.x) up to
the nsc0 stage, stage2.sh after it.

The source hashes are those of fetchzip on GitHub's archive of the commit with
the binaries removed (nix/scala/default.nix: fetchScala); they are computed
here from `git archive` the same way, and reused from an existing chain.nix.
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CHAIN = os.path.join(ROOT, "scala/proto/chain.txt")
OUT = os.path.join(ROOT, "nix/scala/chain.nix")
GIT = sys.argv[1] if len(sys.argv) > 1 else "/tmp/sc/full"

STAGE1 = "d19cd4e679~1"   # the last commit with a complete Java "scalacboot" (2004-02-19)
FJBG = "0f10ffedc8"       # src/fjbg (2009)
MSIL = "4304b15730"       # src/msil (2009)
JLINE5 = "c107643d20"     # src/jline (2009-10), the generified jline of lib/jline.jar from 2009-06
ASM = "6fc2a6897b~1"      # src/asm (2015-05), the last in-tree scala.tools.asm, before the scala-asm artifact
# keep in sync with fetchScala in nix/scala/default.nix
BINARIES = (".jar", ".class", ".so", ".dll", ".dylib", ".exe", ".zip", ".a", ".jnilib")


def git(*args):
    return subprocess.run(["git", "-C", GIT, *args], check=True, capture_output=True,
                          text=True).stdout.strip()


def rev_parse(c):
    return git("rev-parse", c + "^{commit}")


def tree_hash(rev):
    tmp = tempfile.mkdtemp()
    try:
        d = os.path.join(tmp, "src")
        os.mkdir(d)
        tar = subprocess.run(["git", "-C", GIT, "archive", "--format=tar", rev],
                             check=True, capture_output=True).stdout
        subprocess.run(["tar", "-x", "-C", d], input=tar, check=True)
        for dp, _, fs in os.walk(d):
            for f in fs:
                p = os.path.join(dp, f)
                if f.endswith(BINARIES) and not os.path.islink(p):   # find -type f
                    os.remove(p)
        return subprocess.run(["nix", "hash", "path", "--type", "sha256", "--sri", d],
                              check=True, capture_output=True, text=True).stdout.strip()
    finally:
        shutil.rmtree(tmp)


def main():
    known = {}
    if os.path.exists(OUT):
        known = dict(re.findall(r'"([0-9a-f]{40})" = "(sha256-[^"]+)";', open(OUT).read()))

    stages = [dict(name="st1", rev=rev_parse(STAGE1), builder="stage1.sh", prev=None)]
    names = {"1": "st1"}
    builder = "stage.sh"
    for line in open(CHAIN):
        line = line.split("#")[0].strip()
        if not line:
            continue
        if line.startswith("gen "):
            # the stages above (since the previous gen line) build with scala/stages/gen/N
            for st in stages:
                st.setdefault("gen", line.split()[1])
            continue
        name, commit, prev, mode, *env = line.split()
        s = dict(name=name, rev=rev_parse(commit), prev=names[prev])
        if env:
            s["env"] = dict(e.split("=", 1) for e in env)
        if mode == "nsc0":
            s["builder"] = "stage-nsc0.sh"
            builder = "stage2.sh"
        else:
            s["builder"] = builder
        if mode == "cf":
            s["compilerFirst"] = True
        if mode == "fresh":
            s["fresh"] = True
        if mode == "unnest":
            s["unnest"] = True
        if mode.startswith("bridge:"):
            _, frm, files = mode.split(":", 2)
            s["overlay"] = dict(rev=rev_parse(frm), files=files.split(","))
        if mode.startswith("bridge-script:"):
            _, frm, script = mode.split(":", 2)
            s["overlay"] = dict(rev=rev_parse(frm), script=script)
        names[name] = name
        stages.append(s)

    revs = [rev_parse(FJBG), rev_parse(MSIL), rev_parse(JLINE5), rev_parse(ASM)]
    for s in stages:
        revs.append(s["rev"])
        if "overlay" in s:
            revs.append(s["overlay"]["rev"])
    hashes = {}
    for r in revs:
        if r not in hashes:
            hashes[r] = known.get(r) or tree_hash(r)
            if r not in known:
                print(f"hashed {r[:10]}: {hashes[r]}", file=sys.stderr)

    o = ["# Generated by tools/scala-chain from scala/proto/chain.txt -- do not edit.",
         "{",
         f'  fjbg = "{revs[0]}";',
         f'  msil = "{revs[1]}";',
         f'  jline5 = "{revs[2]}";',
         f'  asm = "{revs[3]}";',
         "  # scala/scala trees: rev -> hash of fetchScala",
         "  sources = {"]
    o += [f'    "{r}" = "{h}";' for r, h in hashes.items()]
    o += ["  };", "  stages = ["]
    for s in stages:
        a = [f'name = "{s["name"]}";', f'rev = "{s["rev"]}";', f'builder = "{s["builder"]}";']
        if "gen" in s:
            a.append(f'gen = "{s["gen"]}";')
        if s["prev"]:
            a.append(f'prev = "{s["prev"]}";')
        if s.get("compilerFirst"):
            a.append("compilerFirst = true;")
        if s.get("fresh"):
            a.append("fresh = true;")
        if s.get("unnest"):
            a.append("unnest = true;")
        if "env" in s:
            a.append("env = { %s };" % " ".join('%s = "%s";' % kv for kv in s["env"].items()))
        if "overlay" in s:
            ov = s["overlay"]
            if "script" in ov:
                a.append(f'overlay = {{ rev = "{ov["rev"]}"; script = "{ov["script"]}"; }};')
            else:
                fs = " ".join(f'"{f}"' for f in ov["files"])
                a.append(f'overlay = {{ rev = "{ov["rev"]}"; files = [ {fs} ]; }};')
        o.append("    { " + " ".join(a) + " }")
    o += ["  ];", "}", ""]
    open(OUT, "w").write("\n".join(o))
    print(f"{OUT}: {len(stages)} stages, {len(hashes)} source trees", file=sys.stderr)


if __name__ == "__main__":
    main()
