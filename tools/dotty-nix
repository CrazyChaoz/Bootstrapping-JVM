#!/usr/bin/env python3
"""dotty-nix : writes nix/scala/dotty-chain.nix from scala/proto/{dchain,dlib,ddeps}.txt: the dotty stages
(name, commit, previous stage, Scala 2 library stages) and the hashes of the sources they build from:
the scala/scala3 trees (without binaries, like tools/scala-chain does for scala/scala) and the external
inputs by version (zinc, sbt's util-interface, jline, Scala.js, ASM).  Hashes are cached in
nix/scala/dotty-hashes.json, so that only new inputs are downloaded."""
import concurrent.futures
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request

ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
PROTO = os.path.join(ROOT, "scala/proto")
CACHE = os.path.join(ROOT, "nix/scala/dotty-hashes.json")
BINARY = re.compile(r"\.(jar|class|so|dll|dylib|exe|zip|a|jnilib)$")


def rows(name):
    return [l.split() for l in open(os.path.join(PROTO, name)) if l.strip() and not l.startswith("#")]


def sh(*a):
    return subprocess.run(a, check=True, capture_output=True, text=True).stdout.strip()


def tags(repo):
    out = sh("git", "ls-remote", "--tags", f"https://github.com/{repo}.git")
    return {l.split("refs/tags/")[1] for l in out.splitlines() if "^{}" not in l}


def hash_url(url, strip_binaries):
    """the hash fetchzip gives the unpacked archive (top directory stripped, binaries deleted)"""
    d = tempfile.mkdtemp()
    try:
        tgz = os.path.join(d, "a.tgz")
        urllib.request.urlretrieve(url, tgz)
        os.mkdir(os.path.join(d, "x"))
        subprocess.run(["tar", "xzf", tgz, "-C", os.path.join(d, "x")], check=True)
        (top,) = os.listdir(os.path.join(d, "x"))
        root = os.path.join(d, "x", top)
        if strip_binaries:
            for r, _, fs in os.walk(root):
                for f in fs:
                    q = os.path.join(r, f)
                    if BINARY.search(f) and not os.path.islink(q):  # (find -type f)
                        os.remove(q)
        return sh("nix", "hash", "path", "--sri", root)
    finally:
        shutil.rmtree(d, ignore_errors=True)


chain = rows("dchain.txt")  # NAME COMMIT PREV VERSION SCALAC
lib = {r[0]: r[1:] for r in rows("dlib.txt")}  # NAME LIB BOOTLIB
deps = {r[0]: dict(zip(r[1::2], r[2::2])) for r in rows("ddeps.txt")}
zinc_util = dict(rows("zinc-util.txt")) if os.path.exists(os.path.join(PROTO, "zinc-util.txt")) else {}

want = {}  # kind -> {version: (url)}
T = {r: tags(r) for r in ["sbt/zinc", "jline/jline3", "scala-js/scala-js", "sbt/sbt", "sbt/util"]}


def pick(repo, cands):
    for c in cands:
        if c in T[repo]:
            return c
    sys.exit(f"no tag among {cands} in {repo}")


for d in deps.values():
    for kind, v in d.items():
        if kind == "zinc":
            want.setdefault("zinc", {})[v] = f"https://github.com/sbt/zinc/archive/refs/tags/{pick('sbt/zinc', ['v' + v])}.tar.gz"
        elif kind == "jline":
            t = pick("jline/jline3", [f"jline-parent-{v}", f"jline-{v}", v])
            want.setdefault("jline", {})[v] = f"https://github.com/jline/jline3/archive/refs/tags/{t}.tar.gz"
        elif kind == "scalajs":
            want.setdefault("scalajs", {})[v] = f"https://github.com/scala-js/scala-js/archive/refs/tags/{pick('scala-js/scala-js', ['v' + v])}.tar.gz"
        elif kind == "ow2asm":
            u = v.replace(".", "_")
            want.setdefault("ow2asm", {})[v] = f"https://gitlab.ow2.org/asm/asm/-/archive/ASM_{u}/asm-ASM_{u}.tar.gz"
# sbt's util-interface, by the version zinc's build names (zinc-util.txt: ZINC UTIL)
for zv, uv in zinc_util.items():
    if zv in want.get("zinc", {}):
        repo, tag = ("sbt/util", "v" + uv) if uv == "1.2.2" else ("sbt/sbt", "v" + uv)
        want.setdefault("sbtutil", {})[uv] = f"https://github.com/{repo}/archive/refs/tags/{pick(repo, [tag])}.tar.gz"
for n, rev, *_ in chain:
    want.setdefault("scala3", {})[rev] = f"https://github.com/scala/scala3/archive/{rev}.tar.gz"

cache = json.load(open(CACHE)) if os.path.exists(CACHE) else {}
todo = [(k, v, u) for k, vs in want.items() for v, u in vs.items() if f"{k} {v}" not in cache]
with concurrent.futures.ThreadPoolExecutor(4) as ex:
    futs = {ex.submit(hash_url, u, k == "scala3"): (k, v) for k, v, u in todo}
    for f in concurrent.futures.as_completed(futs):
        k, v = futs[f]
        cache[f"{k} {v}"] = f.result()
        print("hashed", k, v, cache[f"{k} {v}"], file=sys.stderr)
        json.dump(cache, open(CACHE, "w"), indent=1, sort_keys=True)

# builder generations: scala/proto/dgens.txt "GEN LASTSTAGE" lines (the stages up to LASTSTAGE, since the previous one)
gens, last = [], None
for g, st in rows("dgens.txt") if os.path.exists(os.path.join(PROTO, "dgens.txt")) else []:
    gens.append((int(g), [r[0] for r in chain].index(st)))
def gen_of(i):
    return next((g for g, e in sorted(gens) if i <= e), None)


out = ["# Generated by tools/dotty-nix from scala/proto/{dchain,dlib,ddeps}.txt; do not edit.", "{"]
out.append("  stages = [")
for i, (name, rev, prev, ver, scalac) in enumerate(chain):
    gen = gen_of(i)
    out.append(f'    {{ name = "{name}"; {"gen = " + chr(34) + str(gen) + chr(34) + "; " if gen else ""} rev = "{rev}"; prev = {"null" if prev == "-" else chr(34) + prev + chr(34)}; version = "{ver}"; scalac = "{scalac}"; lib = "{lib[name][0]}"; bootlib = "{lib[name][1]}"; deps = {{ ' +
               " ".join(f'{k} = "{v}";' for k, v in deps[name].items()) + " }; }")
out.append("  ];")
for kind in ["scala3", "zinc", "sbtutil", "jline", "scalajs", "ow2asm"]:
    out.append(f"  {kind} = {{")
    for v, u in sorted(want.get(kind, {}).items()):
        out.append(f'    "{v}" = {{ url = "{u}"; hash = "{cache[kind + " " + v]}"; }};')
    out.append("  };")
# the Scala 2 stage at each tag the dotty stages name (the last stage of that commit in scala/proto/chain.txt)
c2s = {}
for r in open(os.path.join(PROTO, "chain.txt")):
    f = r.split()
    if len(f) > 2 and re.fullmatch(r"s\d+", f[0]):
        c2s[f[1]] = f[0]
vers = {r[4] for r in chain if r[4] != "-"} | {v for l in lib.values() for v in l}
out.append("  scala2 = {")
for v in sorted(vers):
    c = sh("git", "-C", os.environ.get("SCALA_CLONE", "/tmp/sc/full"), "rev-parse", f"v{v}^{{commit}}")
    out.append(f'    "{v}" = "{c2s[c]}";')
out.append("  };")
out.append("}")
open(os.path.join(ROOT, "nix/scala/dotty-chain.nix"), "w").write("\n".join(out) + "\n")
print(f"{len(chain)} dotty stages", file=sys.stderr)
