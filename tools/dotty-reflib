#!/usr/bin/env python3
"""dotty-reflib REFLIB OUT LIBROOT PASS1DIR... : copies into OUT the reference compiler's released
library (REFLIB, class files and TASTy) minus what would clash with or shadow the new library:
  - what the first library pass compiles itself (top-level definitions of PASS1DIR sources),
  - classes whose name is a package directory of the new sources (object vs package scala.deriving, 2020-12),
  - classes in packages none of the new library's sources (under LIBROOT, any src* dir) has
    (a dropped package, scala.quoted.util 2020-11).
What remains (e.g. scala.IArray, compiled only from src-bootstrapped, 2019-08) is what the reference
compiler and the new compiler built by it need before the new compiler compiles the library itself."""
import os
import re
import shutil
import subprocess
import sys

reflib, out, libroot, *pass1 = sys.argv[1:]
toplevel = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dotty-toplevel")


def stems(d):
    r = subprocess.run([sys.executable, "-I", toplevel, d], capture_output=True, text=True, check=True)
    return set(r.stdout.split())


own = set().union(*(stems(d) for d in pass1 if os.path.isdir(d)))
pkgs = set()  # package directories of the new library's sources (from their package clauses)
for src in [os.path.join(libroot, d) for d in os.listdir(libroot) if d.startswith("src")]:
    for d, _, fs in os.walk(src):
        for f in fs:
            if f.endswith(".scala") or f.endswith(".java"):
                text = open(os.path.join(d, f), encoding="utf-8", errors="replace").read()
                parts = [p for m in re.findall(r"^package\s+([\w.]+)", text, re.M) for p in m.split(".")]
                for i in range(1, len(parts) + 1):
                    pkgs.add("/".join(parts[:i]))
for d, _, fs in os.walk(reflib):
    rel = os.path.relpath(d, reflib)
    pkg = "" if rel == "." else rel
    if pkg and pkg not in pkgs:
        continue
    for f in fs:
        if not (f.endswith(".class") or f.endswith(".tasty")):
            continue
        top = re.split(r"[$.]", f, 1)[0]
        if f.split(".")[0].endswith("$package") or "$package$" in f:
            top = f.split("$package")[0] + "$package"
        stem = f"{pkg}/{top}" if pkg else top
        if stem in own or stem in pkgs:
            continue
        os.makedirs(os.path.join(out, pkg), exist_ok=True)
        shutil.copy(os.path.join(d, f), os.path.join(out, pkg, f))
