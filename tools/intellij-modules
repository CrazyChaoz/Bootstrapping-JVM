#!/usr/bin/env python3
# usage: intellij-modules BRANCH MODULE...
# Prints the (non-test) module closure of the given intellij-community
# modules with their directories, and the project libraries they use,
# reading .idea/modules.xml and the .iml files from GitHub.
import re, sys, urllib.request, os
branch, start = sys.argv[1], sys.argv[2:]
base = f"https://raw.githubusercontent.com/JetBrains/intellij-community/{branch}/"
def get(p):
    with urllib.request.urlopen(base + p) as r: return r.read().decode()
mods = {}
for m in re.finditer(r'filepath="\$PROJECT_DIR\$/([^"]+\.iml)"', get(".idea/modules.xml")):
    p = m.group(1); mods[os.path.basename(p)[:-4]] = p
seen, order, libs = set(), [], {}
def visit(n):
    if n in seen: return
    seen.add(n)
    if n not in mods: print("?? unknown module", n, file=sys.stderr); return
    s = get(mods[n])
    for m in re.finditer(r'<orderEntry type="module" module-name="([^"]+)"([^>]*)/>', s):
        if 'scope="TEST"' in m.group(2): continue
        visit(m.group(1))
    srcs = re.findall(r'<sourceFolder url="file://\$MODULE_DIR\$/([^"]*)" isTestSource="false"', s)
    for m in re.finditer(r'<orderEntry type="library"([^>]*?)name="([^"]+)"([^>]*)/>', s):
        if 'TEST' in m.group(1) + m.group(3): continue
        libs.setdefault(m.group(2), set()).add(n)
    for m in re.finditer(r'<orderEntry type="module-library"[^>]*>.*?</orderEntry>', s, re.S):
        if 'TEST' in m.group(0)[:80]: continue
        mid = re.search(r'maven-id="([^"]+)"', m.group(0))
        libs.setdefault("(module) " + (mid.group(1) if mid else "?"), set()).add(n)
    order.append((n, os.path.dirname(mods[n]), srcs))
for s in start: visit(s)
for n, d, srcs in order: print(f"{n:55} {d}  src={','.join(srcs)}")
for l, users in sorted(libs.items()): print(f"LIB {l:40} <- {' '.join(sorted(users))}")
