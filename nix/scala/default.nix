# The Scala bootstrap chain: from the Java (Pizza) scalac of 2004, built by
# javac, through Scala 1.x, the first Scala 2 compiler (nsc, 2005-12) and the
# 2.x releases, each stage compiled by the previous one -- no Scala binary
# anywhere.  `nix build .#scala.stages.s14` is Scala 2.0.0.
#
# The stages are listed in chain.nix (generated by tools/scala-chain from the
# chain record scala/proto/chain.txt); the stage builders are the scripts in
# scala/stages (Pizza sources go through tools/pizza2java.py + javac, PiCo
# classfile conventions are emulated by tools/pico-classfiles.py).
{
  lib,
  stdenv,
  fetchzip,
  fetchFromGitHub,
  runCommand,
  python3,
  jdks,
}:

let
  chain = import ./chain.nix;

  # runs the compilers (the old classfile readers and run-time libraries want a Java 8 class library)
  jdk8 = jdks.openjdk8;
  # compiles the Java parts (javac --release 8)
  jdk21 = jdks.openjdk21;

  files =
    root: names:
    lib.fileset.toSource {
      inherit root;
      fileset = lib.fileset.unions (map (n: root + "/${n}") names);
    };
  # Builder generations: the stages verified with a set of scripts and tools keep
  # building with a frozen copy of them (scala/stages/gen/N, chain.txt "gen N"
  # lines), so that later fixes only rebuild the stages after them.  Stages
  # without a generation use the current scripts (scala/stages, tools).
  stagesDir = gen: if gen == null then ../../scala/stages else ../../scala/stages/gen + "/${gen}";
  toolsDir = gen: if gen == null then ../../tools else stagesDir gen + "/tools";
  toolsFor =
    gen:
    files (toolsDir gen) (
      [
        "pizza2java.py"
        "pico-classfiles.py"
        "jdk-api-view.py"
        "scala-unnest.py"
      ]
      # (from generation 6 on)
      ++ lib.optional (builtins.pathExists (toolsDir gen + "/scala-pickle-rename.py")) "scala-pickle-rename.py"
    );
  # each builder sees only its own scripts, so that changing one does not rebuild the whole chain
  scripts = {
    "stage1.sh" = [ "stage1.sh" "stage-java.sh" ];
    "stage.sh" = [ "stage.sh" "common-patches.sh" "stubs.sh" "hello.sh" "Hello.scala" ];
    "stage-nsc0.sh" = [ "stage-nsc0.sh" "nsc-patches.sh" "hello2.sh" "Hello2.scala" ];
    "stage2.sh" = [ "stage2.sh" "nsc-patches.sh" "hello2.sh" "Hello2.scala" ];
  };
  scriptsFor =
    gen: builder:
    let
      d = stagesDir gen;
    in
    lib.fileset.toSource {
      root = d;
      fileset = lib.fileset.unions (
        map (n: d + "/${n}") ([ "env.sh" ] ++ scripts.${builder})
        ++ lib.optional (builder == "stage2.sh") (d + "/patches")
        # (CF_LIBPATCH and LOCKER_SCRIPT scripts, from generation 15 on)
        ++ lib.filter builtins.pathExists (
          lib.optionals (builder == "stage2.sh") [ (d + "/cfpatch") (d + "/lockerpatch") ]
        )
      );
    };

  # A scala/scala tree from GitHub, without the binaries it ships (lib/*.jar
  # reference compilers and the like).  Keep in sync with tools/scala-chain.
  fetchScala =
    rev:
    fetchzip {
      name = "scala-src-${builtins.substring 0 10 rev}";
      url = "https://github.com/scala/scala/archive/${rev}.tar.gz";
      hash = chain.sources.${rev};
      postFetch = ''
        find $out -type f \( -name '*.jar' -o -name '*.class' -o -name '*.so' -o -name '*.dll' \
          -o -name '*.dylib' -o -name '*.exe' -o -name '*.zip' -o -name '*.a' -o -name '*.jnilib' \) -delete
      '';
    };
  sources = lib.mapAttrs (rev: _: fetchScala rev) chain.sources;

  # The Java class library as an old compiler should see it (ct.sym-like):
  # nothing newer than `version`, see tools/jdk-api-view.py.
  apiView =
    gen: version:
    runCommand "jdk-api-${version}.jar" { nativeBuildInputs = [ python3 ]; } ''
      python3 -I ${toolsFor gen}/jdk-api-view.py ${jdk8}/lib/openjdk/src.zip ${jdk8}/lib/openjdk/jre/lib/rt.jar ${version} $out
    '';
  apiViewsFor = gen: {
    "1.4" = apiView gen "1.4";
    "1.5" = apiView gen "1.5";
    "1.6" = apiView gen "1.6";
  };
  apiViews = apiViewsFor null;

  # jline 1.0 (the API of the 0.9.x jars Scala shipped from 2007-07), for the REPL
  jline = stdenv.mkDerivation {
    pname = "jline";
    version = "1.0";
    src = fetchFromGitHub {
      owner = "jline";
      repo = "jline1";
      rev = "jline-1.0";
      hash = "sha256-2ms8i3ChcDUiUUA0+Q9sRiak6qpy38wUcVRGmCqwktY=";
      postFetch = "find $out -name '*.dll' -delete";
    };
    dontConfigure = true;
    dontFixup = true;
    buildPhase = ''
      mkdir -p $out
      ${jdk21}/bin/javac -nowarn --release 8 -encoding utf8 -d $out $(find src/main/java -name '*.java')
      (cd src/main/resources && find . -name '*.properties' -exec install -Dm644 {} $out/{} \;)
    '';
    installPhase = "true";
  };

  # scala-asm, the ASM fork the compiler uses once src/asm is gone (2015-05): ASM 5.1 with
  # Scala's cherry-picks, a superset of the 5.0.x-scala-N and 5.1.0-scala-1 the 2.12 builds name
  scalaAsm = fetchFromGitHub {
    owner = "scala";
    repo = "scala-asm";
    rev = "v5.1.0-scala-2";
    hash = "sha256-DHrPEcX6QcuK6rsqMU32xB/b2OcL0Pbe9Q76kKLuXzc=";
  };

  # the scala-asm releases the trees name in versions.properties (scala-asm.version) from 2017 on,
  # by version: stage2.sh compiles the one its tree names (ASM_SRCS), else scalaAsm
  scalaAsms = lib.mapAttrs (
    v: hash:
    fetchFromGitHub {
      owner = "scala";
      repo = "scala-asm";
      rev = "v${v}";
      inherit hash;
    }
  ) {
    "5.2.0-scala-1" = "sha256-DubVrroyP7k0fgqCBVDx/u5plk8cysG0Z2HgaMb+tcs=";
    "6.0.0-scala-1" = "sha256-G4P2CZv44E4LfZhIuuxoD8a21PLbymR0Md2X04neWM8=";
    "6.2.0-scala-2" = "sha256-vJbPzDHCReqzeClrktocMRIn0Y/DiC0kE3hK0EpHNDc=";
    "7.0.0-scala-1" = "sha256-Q5EFV2W1uernQugwHOiEPqFiEV24tpsAIUXpSSDxLmk=";
  };
  asmSrcsOf =
    asms:
    runCommand "scala-asm-srcs" { } (
      "mkdir $out\n" + lib.concatStrings (lib.mapAttrsToList (v: src: "ln -s ${src}/src/main/java $out/${v}\n") asms)
    );
  scalaAsmSrcs = asmSrcsOf scalaAsms;
  # and the later ones (2.13.x from 2019-12, the dotty compilers); from generation 29 on
  scalaAsmSrcs2 = asmSrcsOf (
    scalaAsms
    // lib.mapAttrs
      (
        v: hash:
        fetchFromGitHub {
          owner = "scala";
          repo = "scala-asm";
          rev = "v${v}";
          inherit hash;
        }
      )
      {
        "7.3.1-scala-1" = "sha256-gCHnwXe9G+fghnLIJY56Y9AYGenjVMbM3fxODxAJaB0=";
        "9.1.0-scala-1" = "sha256-dAxKr6b7HbkIHTyJYPFL2DNMcH24W4Wb7NyBNc2iWfM=";
        "9.2.0-scala-1" = "sha256-5Cb+CaMOM84/GNenoLrZrfdlqIrbVUjPm1OIxD1NwFY=";
        "9.3.0-scala-1" = "sha256-GnR8YbpSnRNvn5f6m+dfnJTHxgPXqir5JunFtkwwjWo=";
        "9.4.0-scala-1" = "sha256-QmCIXoWsx4AGXXFkaYY3TTve8SGLqvhJCDDs9S5l+xA=";
        "9.5.0-scala-1" = "sha256-8HQsQ2Kwhfn5f62gOKKOPxpjgmV6jgjROy7QdPmLrNs=";
        "9.6.0-scala-1" = "sha256-LqXit8/4AK/PZj96rkOSL2brqW08hVCu2ddfV/VFpz0=";
        "9.7.0-scala-2" = "sha256-kdDh4lPkmMURFBpYXgrY49SOELBmfh2ZhV8XhbRnUd8=";
        "9.7.1-scala-1" = "sha256-ZWbI5DK26wVMmJouxg0S2dEaGtb0iqvE0Q5vOY8OTZ4=";
        "9.8.0-scala-1" = "sha256-OqQnxDzJRlFKGN7YS6ANzeZ7IrNiiNLPXGngGGcmRRo=";
        "9.9.0-scala-1" = "sha256-ckAD1N1C0uAxObw3K33D6B+jwFGQvUenZLTI9GB0qVM=";
      }
  );

  # java-diff-utils, by version, for the compiler's -Yprint-trees:diff (2022-05); stage2.sh compiles
  # the one the tree's build.sbt names (DIFFUTILS_SRCS)
  diffutilsSrcs = runCommand "java-diff-utils-srcs" { } (
    "mkdir $out\n"
    + lib.concatStrings (
      lib.mapAttrsToList
        (v: hash: "ln -s ${
          fetchFromGitHub {
            owner = "java-diff-utils";
            repo = "java-diff-utils";
            rev = "java-diff-utils-parent-${v}";
            inherit hash;
          }
        } $out/${v}\n")
        {
          "4.11" = "sha256-jE1dl7GDakUph3r6XmdQAfam2yW2GKKlu3vTpVhCQlY=";
          "4.12" = "sha256-QhdBPejv9yQBY4Oc4NQw2FultQPdi0eGJyqiIL56jQE=";
          "4.15" = "sha256-HZN6chKTLiXTwSA+7Ud2sYG8i9qdQnLSqVfpjIJ1yk0=";
          "4.16" = "sha256-H2F+20URht/Va3EP1Eztq1cjpCfNG77ePRRq1mrYvGY=";
        }
    )
  );

  # Scala's generified jline (lib/jline.jar from 2009-06), as imported as source 2009-10
  jline5 = runCommand "jline-scala-2009" { } ''
    mkdir -p $out
    ${jdk8}/bin/javac -nowarn -encoding utf8 -d $out $(find ${sources.${chain.jline5}}/src/jline/src/main/java -name '*.java')
    cp -r ${sources.${chain.jline5}}/src/jline/src/main/resources/. $out/
  '';

  # jansi 1.4 with jansi-native 1.0 and hawtjni-runtime 1.0, for Scala's jline fork (2010-12);
  # Java parts only: the native Windows console support is never loaded on Unix
  jansi =
    let
      gh =
        repo: rev: hash:
        fetchFromGitHub {
          owner = "fusesource";
          inherit repo rev hash;
        };
      srcs = [
        "${gh "jansi" "jansi-1.4" "sha256-Q8r/CIV34v/UPfdJXMGX0pLEtZC+C2NAYL/SAIfRZao="}/src/main/java"
        "${gh "jansi-native" "jansi-native-1.0" "sha256-2gRYTpwlzrkAbKsrJIAWIVFbkiPEoxDYhYrdpR4QpUM="}/src/main/java"
        "${gh "hawtjni" "hawtjni-1.0" "sha256-4rwOvidZ5mrvIDBCihX+XNxzBg4B9NNcUXQG2C8kw7U="}/hawtjni-runtime/src/main/java"
      ];
    in
    runCommand "jansi-1.4" { } ''
      mkdir -p $out
      ${jdk8}/bin/javac -nowarn -encoding utf8 -d $out $(find ${lib.concatStringsSep " " srcs} -name '*.java')
    '';

  stageSrc =
    s:
    if s ? overlay then
      # a bridge: the tree of `rev` with some files of a later commit (stands in for
      # the unpublished intermediate compilers behind historical reference-compiler updates)
      runCommand "scala-src-${s.name}"
        (
          # (python3 for the bridge scripts that use it, from b119 on; the others keep their hash)
          lib.optionalAttrs (
            s.overlay ? script
            && lib.hasInfix "python3" (builtins.readFile (../../scala/bridges + "/${s.overlay.script}"))
          ) { nativeBuildInputs = [ python3 ]; }
        )
        ''
        cp -r --no-preserve=mode ${sources.${s.rev}} $out
        ${
          if s.overlay ? script then
            "bash ${../../scala/bridges + "/${s.overlay.script}"} $out ${sources.${s.overlay.rev}}"
          else
            lib.concatMapStringsSep "\n" (f: "cp ${sources.${s.overlay.rev}}/${f} $out/${f}") s.overlay.files
        }
      ''
    else
      sources.${s.rev};

  # what later stages and the smoke test use of a stage
  keep = "out2 classes src sc2 lib2 quick";

  mkStage =
    s:
    let
      gen = s.gen or null;
      views = apiViewsFor gen;
      prev = stages.${s.prev};
      prevArg =
        if s.builder == "stage1.sh" then
          ""
        else if s.builder == "stage-nsc0.sh" then
          "${prev}"
        else if s.prev == "st1" then
          "${prev}/sc2:${prev}/lib2:${prev}/classes"
        else
          "${prev}/out2:${prev}/classes";
      hello = if s.builder == "stage.sh" then "hello.sh" else "hello2.sh";
    in
    stdenv.mkDerivation {
      pname = "scala-bootstrap-${s.name}";
      version = builtins.substring 0 10 s.rev;
      src = stageSrc s;
      dontUnpack = true;
      dontConfigure = true;
      dontFixup = true;
      nativeBuildInputs = [ python3 ];
      env = {
        TOOLS = "${toolsFor gen}";
        J = "${jdk21}";
        J8 = "${jdk8}";
        FJBG_SRC = "${sources.${chain.fjbg}}/src/fjbg";
        MSIL_SRC = "${sources.${chain.msil}}/src/msil";
        JLINE_CLS = "${jline}";
        JLINE5_CLS = "${jline5}";
        JANSI_CLS = "${jansi}";
        RT14 = "${views."1.4"}";
        RT15 = "${views."1.5"}";
        S = "/nonexistent"; # the prototype layout must not be used
      }
      // lib.optionalAttrs (s.builder == "stage2.sh") { FJBG_CLS = "${stages.n0}/classes"; }
      // lib.optionalAttrs (s.compilerFirst or false) { COMPILER_FIRST = "1"; }
      // lib.optionalAttrs (s.fresh or false) {
        FALLBACK = "none";
        ARRAY_SRC = "1";
      }
      // lib.optionalAttrs (s.unnest or false) { UNNEST = "1"; }
      # (only where used: the other stages keep their hash)
      // lib.optionalAttrs ((s.env or { }) ? JAVA_API) { RT16 = "${views."1.6"}"; }
      # (scala.tools.asm from source once it left the tree, 2015-05; from generation 24 on)
      // lib.optionalAttrs (gen == null || lib.toInt gen >= 24) { ASM_SRC = "${scalaAsm}/src/main/java"; }
      # (and the version the tree names; from generation 27 on)
      // lib.optionalAttrs (gen == null || lib.toInt gen >= 27) { ASM_SRCS = "${scalaAsmSrcs}"; }
      # (the later scala-asm releases; from generation 29 on)
      // lib.optionalAttrs (gen == null || lib.toInt gen >= 29) { ASM_SRCS = "${scalaAsmSrcs2}"; }
      # (java-diff-utils; from generation 29 on)
      // lib.optionalAttrs (gen == null || lib.toInt gen >= 29) { DIFFUTILS_SRCS = "${diffutilsSrcs}"; }
      // (s.env or { });
      buildPhase = ''
        runHook preBuild
        bash ${scriptsFor gen s.builder}/${s.builder} $src $out ${prevArg}
        runHook postBuild
      '';
      installPhase = ''
        cd $out
        for f in *; do case " ${keep} " in *" $f "*) ;; *) rm -rf "$f" ;; esac; done
        [ -d quick ] && find quick -mindepth 1 -maxdepth 1 ! -name lib -exec rm -rf {} +
        cd - > /dev/null
      '';
      # the stage's compiler compiles and runs a small program
      doInstallCheck = s.builder != "stage1.sh";
      installCheckPhase = ''
        bash ${scriptsFor gen s.builder}/${hello} $out 2>&1 | grep -v '; signature = ' | tee hello.txt
        grep -q '^Hello from' hello.txt
      '';
      passthru = { inherit (s) rev; };
    };

  stages = lib.listToAttrs (map (s: lib.nameValuePair s.name (mkStage s)) chain.stages);
in
{
  inherit
    stages
    sources
    apiViews
    jline
    jline5
    jansi
    ;
  "1.4.0.4" = stages.s10;
  "2.0.0" = stages.s14;
  "2.7.7" = stages.s52;
  "2.11.0" = stages.s180;
  "2.12.0" = stages.s194;
  "2.13.0" = stages.s206;
  latest = stages.${(lib.last chain.stages).name};
}
