# The Scala 3 (dotty) chain: from the dotty of 2019-04, built by Scala 2.12.8 of the Scala 2
# chain, through the releases (and the nightlies in between that the builds name as their
# reference compilers) to 3.10.0, each stage compiled by the previous one.
#
# The stages are those of scala/chain/dotty.txt (dotty-chain.nix, generated by
# tools/dotty-nix); the builder is scala/builders/dotty.sh.
{
  lib,
  stdenv,
  fetchzip,
  python3,
  runCommand,
  jdk8,
  jdk21,
  scala2Stages,
  scalaAsmSrcs,
}:

let
  chain = import ./dotty-chain.nix;

  # a scala/scala3 tree, without the binaries it ships (like the scala/scala trees)
  fetchTree =
    rev:
    fetchzip {
      name = "scala3-src-${builtins.substring 0 10 rev}";
      inherit (chain.sources.scala3.${rev}) url hash;
      postFetch = ''
        find $out -type f \( -name '*.jar' -o -name '*.class' -o -name '*.so' -o -name '*.dll' \
          -o -name '*.dylib' -o -name '*.exe' -o -name '*.zip' -o -name '*.a' -o -name '*.jnilib' \) -delete
      '';
    };

  # the external inputs, a directory of the trees by version (DIR/VERSION)
  byVersion =
    kind:
    runCommand "dotty-${kind}-srcs" { } (
      ''
        mkdir $out
      ''
      + lib.concatStrings (
        lib.mapAttrsToList (v: s: ''
          ln -s ${
            fetchzip {
              name = "${kind}-${v}";
              inherit (s) url hash;
            }
          } $out/${v}
        '') chain.sources.${kind}
      )
    );

  files = lib.fileset.toSource {
    root = ../../scala;
    fileset = lib.fileset.unions [
      ../../scala/builders/common.sh
      ../../scala/builders/dotty.sh
      ../../scala/tests/hello-dotty.sh
      ../../scala/tests/Hello2.scala
    ];
  };
  tools = lib.fileset.toSource {
    root = ../../scala/tools;
    fileset = lib.fileset.unions [
      ../../scala/tools/dotty-deps
      ../../scala/tools/dotty-reflib
      ../../scala/tools/dotty-toplevel
      ../../scala/tools/dotty-sjsir
    ];
  };

  # the builder's inputs, but for the scripts and the stages
  inputs = {
    ASM_SRCS = "${scalaAsmSrcs}";
    OW2ASM_SRCS = "${byVersion "ow2asm"}";
    ZINC_SRCS = "${byVersion "zinc"}";
    SBTUTIL_SRCS = "${byVersion "sbtutil"}";
    JLINE3_SRCS = "${byVersion "jline"}";
    SCALAJS_SRCS = "${byVersion "scalajs"}";
  };

  mkStage =
    s:
    stdenv.mkDerivation {
      pname = "scala3-bootstrap-${s.name}";
      inherit (s) version;
      src = fetchTree s.rev;
      dontUnpack = true;
      dontConfigure = true;
      dontFixup = true;
      nativeBuildInputs = [ python3 ];
      env = {
        JDK8 = "${jdk8}";
        JDK21 = "${jdk21}";
        TOOLS = "${tools}";
        DOTTY_VERSION = s.version;
        SCALA2LIB = "${scala2Stages.${s.scala2lib}}";
      }
      // inputs
      // lib.optionalAttrs (s ? scala2libBoot) { SCALA2LIB_BOOT = "${scala2Stages.${s.scala2libBoot}}"; };
      buildPhase = ''
        runHook preBuild
        bash ${files}/builders/dotty.sh $src $out ${
          if s ? prev then stages.${s.prev} else scala2Stages.${s.scala2lib}
        }
        runHook postBuild
      '';
      installPhase = ''
        runHook preInstall
        rm -rf $out/tree $out/refall $out/refboot $out/sjsir $out/*.files $out/*.log
        runHook postInstall
      '';
      # the stage's compiler compiles and runs a small program
      doInstallCheck = true;
      installCheckPhase = ''
        runHook preInstallCheck
        bash ${files}/tests/hello-dotty.sh $out 2>&1 | tee hello.txt
        grep -q '^Hello from' hello.txt
        runHook postInstallCheck
      '';
      passthru = { inherit (s) rev; };
      meta = {
        description = "Stage ${s.name} of the Scala 3 bootstrap chain (scala/scala3 ${s.version})";
        homepage = "https://github.com/scala/scala3";
        license = lib.licenses.asl20;
        platforms = lib.platforms.linux;
      };
    };

  stages = lib.listToAttrs (map (s: lib.nameValuePair s.name (mkStage s)) chain.stages);
in
{
  inherit stages inputs;
  latest = stages.${(lib.last chain.stages).name};
}
