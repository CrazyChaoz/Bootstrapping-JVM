# The Scala 3 (dotty) chain: from the dotty of 2019-04, built by Scala 2.12.8 of the Scala 2 chain,
# through every release up to 3.10.0, each stage compiled by the previous one (the reference compiler a
# tree's project/Build.scala names).  `nix build .#scala.dotty.stages.d74` is Scala 3.10.0.
# The stages are listed in dotty-chain.nix (generated by tools/dotty-nix from scala/proto/d*.txt); the
# builder is scala/stages/stage-dotty.sh.
{
  lib,
  stdenv,
  fetchzip,
  runCommand,
  python3,
  jdks,
  scala2Stages,
  scalaAsmSrcs,
}:

let
  chain = import ./dotty-chain.nix;
  jdk8 = jdks.openjdk8;
  jdk21 = jdks.openjdk21;

  # a scala/scala3 tree without the binaries it ships (like the scala/scala trees)
  fetchTree =
    rev:
    fetchzip {
      name = "scala3-src-${builtins.substring 0 10 rev}";
      url = chain.scala3.${rev}.url;
      hash = chain.scala3.${rev}.hash;
      postFetch = ''
        find $out -type f \( -name '*.jar' -o -name '*.class' -o -name '*.so' -o -name '*.dll' \
          -o -name '*.dylib' -o -name '*.exe' -o -name '*.zip' -o -name '*.a' -o -name '*.jnilib' \) -delete
      '';
    };

  # the external inputs by version, as stage-dotty.sh takes them
  byVersion =
    kind:
    runCommand "dotty-${kind}-srcs" { } (
      "mkdir $out\n"
      + lib.concatStrings (
        lib.mapAttrsToList (
          v: s:
          "ln -s ${
            fetchzip {
              name = "${kind}-${v}";
              inherit (s) url hash;
            }
          } $out/${v}\n"
        ) chain.${kind}
      )
    );

  stageFiles = lib.fileset.toSource {
    root = ../../scala/stages;
    fileset = lib.fileset.unions (
      map (n: ../../scala/stages + "/${n}") [
        "env.sh"
        "stage-dotty.sh"
        "hello-dotty.sh"
        "Hello2.scala"
      ]
    );
  };
  toolFiles = lib.fileset.toSource {
    root = ../../tools;
    fileset = lib.fileset.unions (
      map (n: ../../tools + "/${n}") [
        "dotty-deps"
        "dotty-reflib"
        "dotty-toplevel"
        "dotty-sjsir"
      ]
    );
  };

  mkStage =
    s:
    let
      prev = if s.prev == null then scala2Stages.${chain.scala2.${s.lib}} else stages.${s.prev};
    in
    stdenv.mkDerivation {
      pname = "scala3-bootstrap-${s.name}";
      version = s.version;
      src = fetchTree s.rev;
      dontUnpack = true;
      dontConfigure = true;
      dontFixup = true;
      nativeBuildInputs = [ python3 ];
      env = {
        TOOLS = "${toolFiles}";
        J = "${jdk21}";
        J8 = "${jdk8}";
        S = "/nonexistent"; # the prototype layout must not be used
        SCALA2LIB = "${scala2Stages.${chain.scala2.${s.lib}}}";
        SCALA2LIB_BOOT = "${scala2Stages.${chain.scala2.${s.bootlib}}}";
        ASM_SRCS = "${scalaAsmSrcs}";
        OW2ASM_SRCS = "${byVersion "ow2asm"}";
        ZINC_SRCS = "${byVersion "zinc"}";
        SBTUTIL_SRCS = "${byVersion "sbtutil"}";
        JLINE3_SRCS = "${byVersion "jline"}";
        SCALAJS_SRCS = "${byVersion "scalajs"}";
      };
      buildPhase = ''
        runHook preBuild
        bash ${stageFiles}/stage-dotty.sh $src $out ${prev}
        runHook postBuild
      '';
      installPhase = ''
        cd $out
        rm -rf tree refall refboot sjsir *.files *.log
        cd - > /dev/null
      '';
      # the stage's compiler compiles and runs a small program
      doInstallCheck = true;
      installCheckPhase = ''
        bash ${stageFiles}/hello-dotty.sh $out 2>&1 | tee hello.txt
        grep -q '^Hello from' hello.txt
      '';
      passthru = { inherit (s) rev version; };
    };

  stages = lib.listToAttrs (map (s: lib.nameValuePair s.name (mkStage s)) chain.stages);
in
{
  inherit stages;
  latest = stages.${(lib.last chain.stages).name};
  "3.10.0" = stages.${(lib.last chain.stages).name};
}
