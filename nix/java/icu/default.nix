# ICU 70.1's data (icudata.jar for ICU4J), built from source.
#
# The ICU source releases ship the data prebuilt (icudata.jar in icu4j,
# icudt70l.dat in icu4c), and even the git tree checks in the Unicode
# property/normalization/collation data (icu4c/source/data/in/*.icu, *.nrm) and
# the C headers generated from it.  All of these are removed from the source,
# then regenerated from the Unicode Character Database text files the way ICU's
# own bootstrap does (icu4c/source/data/unidata/generate.sh): gennorm2,
# genprops and genuca are each built from a small subset of the library that
# doesn't need the generated data (taken from ICU's Bazel BUILD files, see
# bazel-srcs.py).  Then ICU4C is built normally, its data compiled from the
# text sources, and packaged for ICU4J.
#
# One generated file remains: i18n/collationfcd.cpp (FCD tables, generated by
# genuca), which genuca itself links.  It is regenerated here, and the build
# checks that the result is identical to the checked-in one.
{
  lib,
  stdenv,
  fetchzip,
  python3,
  jdk,
}:

stdenv.mkDerivation {
  pname = "icu-data";
  version = "70.1";

  src = fetchzip {
    name = "icu-70.1-src";
    url = "https://github.com/unicode-org/icu/archive/refs/tags/release-70-1.tar.gz";
    hash = "sha256-fwwY+YEuFL69AKTqa/GnmV6dJN+0FBZ3/BWzn1KDKPA=";
    postFetch = ''
      find $out -type f \( -name '*.jar' -o -name '*.dat' -o -name '*.res' -o -name '*.icu' \
        -o -name '*.nrm' -o -name '*.cnv' -o -name '*.brk' -o -name '*.cfu' -o -name '*.spp' \
        -o -name '*.dict' -o -name '*.class' \) -delete
      # The headers generated from the Unicode data (see generate.sh).
      rm $out/icu4c/source/common/{norm2_nfc_data,propname_data,ubidi_props_data,ucase_props_data,uchar_props_data}.h
    '';
  };

  nativeBuildInputs = [ python3 ];

  dontConfigure = true;

  buildPhase = ''
    runHook preBuild
    export ICU_SRC=$PWD
    cp icu4c/source/i18n/collationfcd.cpp collationfcd.cpp.orig

    # Compile and link a generator from the sources of its Bazel target.
    gen() {
      export name=$1
      mkdir -p obj/$name bin
      python3 -I ${./bazel-srcs.py} "$ICU_SRC" "$2" |
        xargs -P "$NIX_BUILD_CORES" -d '\n' -n 1 sh -c '
          defs=$(printf %s "$1" | cut -f1); path=$(printf %s "$1" | cut -f2)
          flags=""
          for d in $(echo "$defs" | tr , " "); do flags="$flags -D$d"; done
          $CXX -std=c++11 -O2 -c $flags \
            -I icu4c/source/common -I icu4c/source/i18n -I icu4c/source/tools/toolutil \
            -I "$(dirname "$path")" "$path" -o "obj/$name/$(echo "$path" | tr / _).o"
        ' sh
      $CXX -o bin/$name obj/$name/*.o -pthread -ldl
    }

    C=icu4c/source/common
    IN=icu4c/source/data/in
    N=icu4c/source/data/unidata/norm2
    mkdir -p $IN/coll

    gen gennorm2 //icu4c/source/tools/gennorm2
    bin/gennorm2 -o $C/norm2_nfc_data.h -s $N nfc.txt --csource
    bin/gennorm2 -o $IN/nfc.nrm -s $N nfc.txt
    bin/gennorm2 -o $IN/nfkc.nrm -s $N nfc.txt nfkc.txt
    bin/gennorm2 -o $IN/nfkc_cf.nrm -s $N nfc.txt nfkc.txt nfkc_cf.txt
    bin/gennorm2 -o $IN/uts46.nrm -s $N nfc.txt uts46.txt

    gen genprops //tools/unicode/c/genprops
    bin/genprops $ICU_SRC/icu4c

    gen genuca //tools/unicode/c/genuca
    bin/genuca --hanOrder implicit $ICU_SRC/icu4c
    bin/genuca --hanOrder radical-stroke $ICU_SRC/icu4c

    if ! cmp collationfcd.cpp.orig icu4c/source/i18n/collationfcd.cpp; then
      echo "regenerated collationfcd.cpp differs from the checked-in one" >&2
      diff collationfcd.cpp.orig icu4c/source/i18n/collationfcd.cpp | head -40 >&2
      exit 1
    fi

    # ICU4C itself, with the data built from the text sources.
    cd icu4c/source
    patchShebangs .
    ICU_DATA_BUILDTOOL_OPTS=--include_uni_core_data ./configure --prefix=$out \
      --disable-tests --disable-samples --disable-extras --disable-layoutex
    make -j$NIX_BUILD_CORES
    make -C data JAR=${jdk}/bin/jar icu4j-data
    cd ../..
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    install -Dm644 -t $out/share/java icu4c/source/data/out/icu4j/icudata.jar icu4c/source/data/out/icu4j/icutzdata.jar
    runHook postInstall
  '';
}
