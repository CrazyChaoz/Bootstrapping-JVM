#!/usr/bin/env python3
"""dotty-sjsir OUT DIR... : the scalajs-ir sources of DIR... copied into OUT with the package
rewritten as dotty's build does since 2024 (`package org.scalajs.ir` -> `package dotty.tools.sjs.ir`
on the first package line, and `import scala.language.unsafeNulls` after the package clauses),
printing the files."""
import os
import sys

out, *dirs = sys.argv[1:]
for d in dirs:
    for root, _, fs in os.walk(d):
        for f in sorted(fs):
            if not f.endswith(".scala"):
                continue
            lines = open(os.path.join(root, f), encoding="utf-8").read().split("\n")
            for i, l in enumerate(lines):
                if l.startswith("package "):
                    if l[len("package "):].strip() == "org.scalajs.ir":
                        lines[i] = "package dotty.tools.sjs.ir"
                    break
            res, found, done = [], False, False
            for l in lines:
                lt = l.strip()
                if not done:
                    if found:
                        if not (lt == "" or lt.startswith("package ")):
                            res.append("import scala.language.unsafeNulls")
                            done = True
                    elif lt.startswith("package "):
                        found = True
                res.append(l)
            dst = os.path.join(out, os.path.relpath(os.path.join(root, f), d))
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            open(dst, "w", encoding="utf-8").write("\n".join(res))
            print(dst)
